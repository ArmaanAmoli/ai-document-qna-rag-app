# Database
DATABASE_URL="postgresql://user:password@localhost:5432/rag_doc_qa"

# JWT Secret - MUST be set in production
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRY="30d"

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Gemini API
GEMINI_API_KEY="your-gemini-api-key"

# Embedding Service
EMBEDDING_SERVICE_URL="http://localhost:8001"

# Redis Cache (optional - for semantic/embedding/response caching)
REDIS_URL="redis://localhost:6379"

# Observability (OpenTelemetry)
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://localhost:4318/v1/traces"

# App Configuration
MAX_UPLOAD_SIZE_MB=50
MAX_FILE_SIZE_MB=50
MAX_PAGES_PER_DOCUMENT=1000
RAG_TOP_K=10
NODE_ENV=development

# Rate Limiting
RATE_LIMIT_UPLOADS_PER_MINUTE=10
RATE_LIMIT_QUESTIONS_PER_MINUTE=20
RATE_LIMIT_EMBEDDINGS_PER_MINUTE=50

# Document Processing
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_DIMENSION=384
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# LLM Configuration
LLM_MODEL="gemini-2.5-flash"
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# Security
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="your-encryption-key-32-chars-min"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"

# Optional
HUGGINGFACE_API_KEY="your-hf-api-key"
